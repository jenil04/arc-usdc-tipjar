# Copy to .env.local for local development. Set the same values on your host (e.g. Vercel).

# Where payments settle: arc | arc-testnet | base | base-sepolia
# Arc Microgrants require Arc mainnet.
NETWORK=arc

# Wallet that receives USDC (x402 PAY_TO). Use a dedicated wallet for this service.
PAY_TO=

# Settlement auth for Circle's Facilitator Service. Set ONE of:
#   CIRCLE_API_KEY: production (console.circle.com). Removes the trial limit.
#   SELLER_PRIVATE_KEY: keyless trial, no account. The private key that controls PAY_TO;
#     it signs a short-lived proof per payment. Keep it server-side only, and move your
#     earnings out regularly. Each PAY_TO gets a limited number of trial settlements.
CIRCLE_API_KEY=
SELLER_PRIVATE_KEY=

# Deployed UsdcTipJar address on Arc (set after ./contracts/deploy.sh). Shown on / and /api/arc-status.
NEXT_PUBLIC_TIP_JAR_ADDRESS=

# Shown on / (the docs page), /llms.txt, and the MCP server info.
NEXT_PUBLIC_APP_NAME="Arc USDC Tip Jar"
NEXT_PUBLIC_APP_DESCRIPTION="UsdcTipJar on Arc mainnet + x402-paid status for agents. Tips go to the owner; agents can pay for live chain + tip-jar info."
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only for `npm run pay` (testing): a buyer wallet holding a little USDC.
BUYER_PRIVATE_KEY=
